{
  "framework": "nextjs",
  "regions": ["sin1"],
  "functions": {
    "app/api/scan/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/print-sweep",
      "schedule": "*/5 * * * *"
    }
  ]
}
