# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gemini (used in Plan 2)
GEMINI_API_KEY=

# Gemini model override (optional). Single model — fallback ke Pro dihapus
# per plan 2026-06-30-ocr-token-reduction.
# Default: gemini-3.5-flash
# Examples: gemini-2.5-flash (cheap), gemini-3.5-flash (better accuracy)
# GEMINI_FAST_MODEL=gemini-3.5-flash

# Cron (used in Plan 3)
CRON_SECRET=

# Business day cutoff (jam WIB). Default 12 = transaksi sebelum 12:00 siang
# masuk ke business_date kemarin. Aman selama warung tidak buka jam 05:00-17:00.
NEXT_PUBLIC_BUSINESS_DAY_CUTOFF_HOURS=12

FIREBASE_SERVICE_ACCOUNT_B64=
