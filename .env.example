# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gemini (used in Plan 2)
GEMINI_API_KEY=

# Gemini model override (optional). Single model — fallback ke Pro dihapus
# per plan 2026-06-30-ocr-token-reduction.
# Default: gemini-3.5-flash
# Examples: gemini-2.5-flash (cheap), gemini-3.5-flash (better accuracy)
# GEMINI_FAST_MODEL=gemini-3.5-flash

# Image compression max dimension (client-side, browser bundle).
# Default 1600. Turun ke 1024 / 800 untuk cost saving Gemini image tokens.
# Range: 256-4096. Di bawah 800 ada risk handwritten qty ga terbaca.
NEXT_PUBLIC_IMAGE_MAX_WIDTH=1024

# Cron (used in Plan 3)
CRON_SECRET=

# Business day cutoff (jam WIB). Default 12 = transaksi sebelum 12:00 siang
# masuk ke business_date kemarin. Aman selama warung tidak buka jam 05:00-17:00.
NEXT_PUBLIC_BUSINESS_DAY_CUTOFF_HOURS=12

FIREBASE_SERVICE_ACCOUNT_B64=

# Gemini pricing → IDR estimate for /setup/ai-usage.
# Default = Gemini 3.5 Flash rate at design time (2026-07). Update jika harga berubah.
GEMINI_INPUT_RATE_USD_PER_1M=1.50
GEMINI_OUTPUT_RATE_USD_PER_1M=9
USD_IDR_RATE=18000
