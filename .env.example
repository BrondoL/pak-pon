# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gemini (used in Plan 2)
GEMINI_API_KEY=

# Gemini model overrides (optional — defaults shown in code).
# FAST = primary scan. CAREFUL = auto-fallback + "Scan ulang" rescan target.
# Examples: gemini-2.5-flash (cheap), gemini-3.5-flash (better accuracy ~4x cost),
#           gemini-2.5-pro (slow but accurate), gemini-3-flash (preview)
# GEMINI_FAST_MODEL=gemini-3.5-flash
# GEMINI_CAREFUL_MODEL=gemini-2.5-pro

# Cron (used in Plan 3)
CRON_SECRET=

# Business day cutoff (jam WIB). Default 12 = transaksi sebelum 12:00 siang
# masuk ke business_date kemarin. Aman selama warung tidak buka jam 05:00-17:00.
NEXT_PUBLIC_BUSINESS_DAY_CUTOFF_HOURS=12
